0000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00,0.000000e+00
OnlyAWGChans       False
PCycleAllowed      True
PCycleOn           True
PPExtTrg           False
PPExtTrgSlope      Rising
PlsSPELEXPSlct     2P ESEEM
PlsSPELGlbTxt      \
;\n\
;       ESEEM package\n\
;\n\
;     PulseSPEL general variables, definitions & conventions\n\
begin defs\n\
; Variables     ; Comments:\n\
\n\
p0   = 8       ; 90 pulse length\n\
p1   = 16      ; 180 pulse length\n\
p2   = 32      ; inversion pulse\n\
p3   = 40      ;\n\
\n\
pg   = 4       ; Integrator Gate Width (RESERVED)\n\
d0   = 586     ; Detection Trigger offset time\n\
\n\
d1   = 180     ; tau\n\
d2   = 180     ; tau 2 (Remote Detection ESEEM and 5 pulse ESEEM)\n\
d3   = 400     ; T\n\
d4   = 400     ;\n\
d5   = 8       ; delay for Store pulse in Remote Detection 2pulse ESEEM and 5 pulse ESEEM\n\
\n\
d9   = 0       ; DAF (Delay After Flash) delay pulse sequence until\n\
               ; after external event (eg. laser pulse)\n\
d30  = 8       ; 1st time scale increment\n\
d31  = 4       ; 2nd time scale increment\n\
\n\
a    = 100     ; (RESERVED) number of transient averages (TRANS)\n\
               ; if greater than 1024, a must be a multiple of 1024\n\
h    = 50      ; (CONVENTION) number of shots per point (INTG and SPT)\n\
n    = 1       ; (CONVENTION) number of sweeps to accumulate\n\
\n\
srt  = 1000 * srtu ; (RESERVED) SRT - Shot Repetition Time (srtu=1.02 us)\n\
\n\
b    = 1       ;\n\
c    = 1       ;\n\
r    = 1       ;\n\
w    = 800     ; (CONVENTION) Split point of sweeps (points)\n\
               ; i.e. pulse separation where TWT gate pulse can be split.\n\
dx   = 0       ; (RESERVED) 1st time scale starting value\n\
dy   = 0       ; (RESERVED) 2nd time scale starting value\n\
end defs\n\
\n\
; Note:\n\
;       Variables Marked 'RESERVED' = variable may be used for other times,\n\
;                                       however only this variable can change\n\
;                                        the indicated parameter.\n\
;                                       eg. only 'a' will change the number of\n\
;                                           transients averaged in SpecJet\n\
\n\
\n
PlsSPELLISTSlct    2-step
PlsSPELPhPrgEx     Normal
PlsSPELPrg         ESEEM/2p_ESEEM.exp
PlsSPELPrgTxt      \
;\n\
; 2-Pulse ESEEM\n\
;\n\
;\n\
begin defs		; dimension of data array [sx,sy]\n\
 dim s[1024]		; 	for set-up\n\
 dim1 s[512]		; 	for fieldsweep\n\
 dim2 s[1024]		;	for ESEEM\n\
 dim3 s[256,10]	;	for ESEEM vs. field\n\
end defs\n\
;\n\
;\n\
begin lists "none"\n\
 ph1 +x\n\
 ph2 +x\n\
 ph3 +x\n\
 ph4 +x\n\
 ph5 +x\n\
 asg1 +a\n\
 bsg1 +b\n\
end lists\n\
\n\
begin lists1 "2-step"\n\
 ph1 +x -x\n\
 ph2 +x +x\n\
 asg1 +a -a\n\
 bsg1 +b -b\n\
end lists1\n\
\n\
begin lists2 "16-step"\n\
 ph1 +x -x +y -y  +x -x +y -y\n\
 ph2 +x -x +y -y  -x +x -y +y   +y -y -x +x -y +y +x -x\n\
 asg1 +a -a +b -b  +a -a +b -b  -a +a -b +b -a +a -b +b\n\
 bsg1 +b -b -a +a  +b -b -a +a  -b +b +a -a -b +b +a -a\n\
end lists2\n\
;\n\
;\n\
;\n\
; Standing Echo for 2-Pulse Set-Up\n\
;\n\
begin exp "2P ESE Setup" [TRANS QUAD]\n\
	; QUAD detection of Transient\n\
\n\
    shot i=1 to a              ; accumulation loop\n\
      d9                       ; DAF (Delay After Flash)\n\
      p0 [ph1]                 ; 1st pulse and phase program\n\
      d1                       ; tau\n\
      p1 [ph2]                 ; 2nd pulse and phase program\n\
      d1                       ; tau\n\
      d0                       ; constant acquisition delay\n\
      dig [sg1]                ; acquisition\n\
    next i                     ; end of accumulation loop\n\
\n\
end exp\n\
\n\
;\n\
; 2-Pulse Field Sweep\n\
;\n\
begin exp1 "2P ESE Field Sweep" [INTG QUAD]\n\
	; QUAD detection with Integration\n\
\n\
 for k=1 to n			; averaging loop\n\
  totscans(n)			; output of total number of scans\n\
\n\
  bsweep x=1 to sx		; field sweep loop\n\
    shot i=1 to h		; accumulation loop\n\
      d9			; DAF (Delay After Flash)\n\
      p0 [ph1]			; 1st pulse and phase program\n\
      d1			; tau\n\
      p1 [ph2]			; 2nd pulse and phase program\n\
      d1			; tau\n\
      d0			; constant acquisition delay\n\
      acq [sg1]			; acquisition\n\
    next i			; end of accumulation loop\n\
\n\
   next x			; end of field sweep loop\n\
\n\
  scansdone(k)			; output of scans done\n\
 next k				; end of averaging loop\n\
\n\
end exp1\n\
\n\
;\n\
; 2-Pulse ESEEM\n\
;\n\
begin exp2 "2P ESEEM" [SPT QUAD]\n\
	; QUAD detection Single Point\n\
\n\
for k=1 to n			; averaging loop\n\
 totscans(n)			; output of total number of scans\n\
\n\
 dx=d1				; starting tau and assignment of x-axis\n\
\n\
   sweep x=1 to sx		; tau sweep loop\n\
    shot i=1 to h		; accumulation loop\n\
      d9			; DAF (Delay After Flash)\n\
      p0 [ph1]			; 1st pulse and phase program\n\
      dx			; tau\n\
      p1 [ph2]			; 2nd pulse and phase program\n\
      dx			; tau\n\
      d0			; constant acquisition delay\n\
      acq [sg1]			; acquisition\n\
    next i			; end of accumulation loop\n\
    dx=dx+d30			; increment tau\n\
\n\
   next x			; end of tau sweep loop\n\
\n\
  scansdone(k)			; output of scans done\n\
 next k				; end of averaging loop\n\
\n\
end exp2\n\
\n\
;\n\
; 2-Pulse ESEEM vs Field Sweep\n\
;\n\
begin exp3 "2P ESEEM vs. B0" [INTG QUAD]\n\
	; QUAD detection with Integration\n\
\n\
bsweep y=1 to sy		; field sweep on y-axis\n\
\n\
 for k=1 to n			; averaging loop for time scan\n\
 totscans(n)			; output of total number of scans\n\
\n\
 dx=d1				; starting tau and assignment of x-axis\n\
\n\
   sweep x=1 to sx		; tau sweep loop\n\
    shot i=1 to h		; accumulation loop\n\
      d9			; DAF (Delay After Flash)\n\
      p0 [ph1]			; 1st pulse and phase program\n\
      dx			; tau\n\
      p1 [ph2]  		; 2nd pulse and phase program\n\
      dx			; tau\n\
      d0			; constant acquisition delay\n\
      acq [sg1]			; acquisition\n\
    next i			; end of accumulation loop\n\
\n\
    dx=dx+d30			; increment tau\n\
   next x			; end of sweep loop\n\
\n\
  scansdone(k)			; output of scans done\n\
 next k				; end of averaging loop\n\
\n\
next y				; end of field sweep\n\
\n\
end exp3\n\
\n\
\n
PlsSPELShpTxt      
