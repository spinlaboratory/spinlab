[general]
version = 1.1
demon = 3.6.7
name = 6-Pulse DQC
dconfig = CNIGM0114rev1.cfg
pconfig = CNIGM0114rev1.cfp
specmode = 
normalized = false
starttime = Wed Aug 20 16:36:25 2025
finishtime = Wed Aug 20 16:39:08 2025
totaltime = 0h 2min 43s
tformat = 1
stream_axis = 256
no_auto_save = 0

[text]

[sweep]
transient = I,500,2,a,b
sweep0 = S,64,1,idx
sweep1 = X,64,1,t
sweep2 = P,1,10,RepTime,Sampling,tdelay,f,t90,t180,ModulationFrequency,ModulationBandwidth,tau1,tau2,T_DQ,amp90,amp180

[aquisition]
a = ;a;A@DG
b = ;a;B@DG

[params]
idx = 1 step 1;p;PPL variable
t = -500 ns step 16 ns;p;PPL variable
RepTime = 1 ms;p;PPL variable
Sampling = 400 ps;p;Sampling@DG
tdelay = 0 s;p;PPL variable
f = 500 MHz;p;PPL variable
t90 = 4 ns;p;PPL variable
t180 = 8 ns;p;PPL variable
ModulationFrequency = 500 MHz;p;ModulationFrequency@DG
ModulationBandwidth = 400 MHz;p;ModulationBandwidth@DG
tau1 = 800 ns;p;PPL variable
tau2 = 800 ns;p;PPL variable
T_DQ = 146 ns;p;PPL variable
amp90 = 1;p;PPL variable
amp180 = 1;p;PPL variable

[decision]

[streams]
names = Re, Im
units = V, V
dwelltime = 400 ps, 400 ps
triggers = 1
scans = 10, 10

[program]
time tdelay, t, tau1, tau2, t90, t180, T_DQ
frequency f
real amp90, amp180
signal a,b
int idx


