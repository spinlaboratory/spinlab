set1 = [amp90, f, ph1(idx)]
set2 = [amp180, f, ph2(idx)]
set3 = [amp90, f, ph3(idx)]
set4 = [amp180, f, ph4(idx)]
set5 = [amp90, f, ph5(idx)]
set6 = [amp180, f, ph6(idx)]

reference f
trig 100ns
wait 100ns

timezero

awg t90, set1  %%pulse 1, 90-pulse
wait tau1/2 + t/2
awg t180, set2 %%pulse 2, 180-pulse
wait tau1/2 + t/2
awg t90, set3 %%pulse 3, 90-pulse
wait T_DQ
awg t180, set4 %%pulse 4, 180-pulse
wait T_DQ
awg t90, set5 %%pulse 5, 90-pulse
wait tau2/2 - t/2
awg t180, set6 %% pulse 6, 180-pulse
wait tau2/2 - t/2 + tdelay

detect det1(idx), det2(idx)

